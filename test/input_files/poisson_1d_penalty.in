# Materials
[Materials]
   [./TestMaterial]
      [./ThermalConductivity]
          model = 'constant'
          value = '1.0'
      [../Density]
         value = '1.0'
      [../SpecificHeat]
         model = 'constant'
         value = '1.0'
[]

eps = 1e-2
offset = 2.5

# Options related to all Physics
[Physics]
   enabled_physics = 'HeatConduction ParsedSourceTerm PenaltyDirichlet'

   [./HeatConduction]
      material = 'TestMaterial'

   [../PenaltyDirichlet]
      penalty = ${/ 1.0 ${eps}}
      pin_variable = 'u'
      pin_target = '${offset}'
      bc_ids = '1'

   [../ParsedSourceTerm]
      [./Function]
         # Forcing function corresponding to -\Delta u, where u =
         # x*((2*eps+1)/(eps+1)-x)
         value = '2'
      [../Variables]
         names = 'u'
         FE_types = 'LAGRANGE'
         FE_orders = 'SECOND'
[]

[BoundaryConditions]
   bc_ids = '0 1'
   bc_id_name_map = 'Dirichlet Other'

   [./Dirichlet]
      [./Temperature]
         type = 'parsed_dirichlet'
         u = '${offset}'
      [../]
   [../]

   [./Other]
      [./Temperature]
         type = 'homogeneous_neumann'
      [../]
   [../]
[]

[Variables]
   [./Temperature]
      names = 'u'
      fe_family = 'LAGRANGE'
      order = 'SECOND'
[]

# Mesh related options
[Mesh]
   [./Generation]
      dimension = '1'

      n_elems_x = '2'

      x_min = '0.0'
      x_max = '1.0'
      element_type = 'EDGE3'
[]

#Linear and nonlinear solver options
[linear-nonlinear-solver]
   max_nonlinear_iterations =  25
   max_linear_iterations = 2500
   initial_linear_tolerance = '1e-10'
   absolute_residual_tolerance = '1.0e-10'
   relative_residual_tolerance = '1.0e-10'
   relative_step_tolerance = '1.0e-12'
   minimum_linear_tolerance = '1.0e-10'
[]

# Visualization options
[vis-options]
   output_vis = 'true'
   vis_output_file_prefix = 'poisson_1d_penalty'
   output_format = 'xda'
[]

# Options for print info to the screen
[screen-options]
   system_name = 'GRINS-TEST'
   print_equation_system_info = 'true'
   print_mesh_info = 'true'
   print_log_info = 'true'
   solver_verbose = 'true'
   solver_quiet = 'false'
[]
