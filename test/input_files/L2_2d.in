# Options related to all Physics
[Physics]
   enabled_physics = 'ParsedSourceTerm LinearReaction'

   # Simple u=f mass-matrix solve
   [./LinearReaction]
      variable = 'u'
      coeff = -1

   [../ParsedSourceTerm]
      [./Function]
         value = 'x*(1-x)*y*(1-y)'
      [../Variables]
         names = 'u'
         FE_types = 'LAGRANGE'
         FE_orders = 'SECOND'
[]

[BoundaryConditions]
   bc_ids = '0:1:2:3'
   bc_id_name_map = 'None'

   [./None]
      [./SingleVariable]
         type = 'homogeneous_neumann'
      [../]
   [../]
[]

[Variables]
   [./SingleVariable]
      names = 'u'
      fe_family = 'LAGRANGE'
      order = 'SECOND'
[]

# Mesh related options
[Mesh]
   [./Generation]
      dimension = '2'

      n_elems_x = '1'
      n_elems_y = '1'

      x_min = '0.0'
      x_max = '1.0'
      y_min = '0.0'
      y_max = '1.0'
      element_type = 'QUAD9'
[]

#Linear and nonlinear solver options
[linear-nonlinear-solver]
   max_nonlinear_iterations =  25
   max_linear_iterations = 2500
   initial_linear_tolerance = '1e-10'
   absolute_residual_tolerance = '1.0e-10'
   relative_residual_tolerance = '1.0e-10'
   relative_step_tolerance = '1.0e-12'
   minimum_linear_tolerance = '1.0e-10'
[]

# Visualization options
[vis-options]
   output_vis = 'true'
   vis_output_file_prefix = 'L2_2d'
   output_format = 'xda'
[]

# Options for print info to the screen
[screen-options]
   system_name = 'GRINS-TEST'
   print_equation_system_info = 'true'
   print_mesh_info = 'true'
   print_log_info = 'true'
   solver_verbose = 'true'
   solver_quiet = 'false'
[]
